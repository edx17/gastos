# ---------------------------------------------------------------------------
# Crocante · variables de entorno
# Copiá este archivo a .env y completá lo que uses. Nunca subas .env al repo.
# Todo lo que empieza con VITE_ termina en el bundle del navegador: no pongas
# ahí ninguna clave que no puedas mostrar públicamente.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Sin estas dos variables la app arranca en MODO DEMO: funciona completa, pero
# los datos quedan guardados en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Moneda ----------------------------------------------------------------
VITE_BASE_CURRENCY=ARS

# --- Inteligencia artificial ----------------------------------------------
# mock | openai | anthropic | gemini
# "mock" no llama a ningún modelo: usa el parser determinista local.
VITE_AI_PROVIDER=mock
VITE_AI_MODEL=

# Cuando es true (por defecto) las llamadas van a la Edge Function `ai-complete`
# y las API keys viven en el servidor. Ponelo en false sólo para desarrollo local.
VITE_USE_EDGE_FUNCTIONS=true

# --- OCR de tickets --------------------------------------------------------
# mock | ocrspace | google_vision | azure_vision | openai_vision | gemini_vision
VITE_OCR_PROVIDER=mock
VITE_MAX_RECEIPT_MB=8

# ---------------------------------------------------------------------------
# Claves privadas: SOLO para las Edge Functions.
#   supabase secrets set --env-file .env
# No las prefijes con VITE_ salvo que estés probando en local sin Supabase.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=

OCR_PROVIDER=ocrspace
OCR_API_KEY=
# Azure y OCR.space usan endpoint propio; el resto lo ignora.
OCR_ENDPOINT=

# Origen permitido para las Edge Functions (por defecto, cualquiera).
ALLOWED_ORIGIN=http://localhost:5173

# --- OAuth (opcional) ------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
